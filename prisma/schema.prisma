generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Decision  Decision[]
}

model Decision {
  id           String    @id @default(cuid())
  title        String    @default("Untitled Decision")
  labelAuto    Boolean   @default(true)
  userDecision String
  aiDecision   String?
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  pros         Pro[]
  cons         Con[]
  comments     Comment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  Option       Option[]
}

model Pro {
  id         String   @id @default(cuid())
  content    String
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id])
}

model Con {
  id         String   @id @default(cuid())
  content    String
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id])
}

model Comment {
  id         String   @id @default(cuid())
  text       String
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id])
  createdAt  DateTime @default(now())
}

model Option {
  id         String      @id @default(cuid())
  title      String
  reason     String?
  rank       Int?
  decisionId String
  decision   Decision    @relation(fields: [decisionId], references: [id])
  pros       ProOption[]
  cons       ConOption[]
}

model ProOption {
  id       String @id @default(cuid())
  content  String
  optionId String
  option   Option @relation(fields: [optionId], references: [id])
}

model ConOption {
  id       String @id @default(cuid())
  content  String
  optionId String
  option   Option @relation(fields: [optionId], references: [id])
}
